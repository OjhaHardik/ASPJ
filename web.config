<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (allenhousejhansi.com runs IIS) ignores .htaccess: this blocks public download of data/enquiries.csv. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
